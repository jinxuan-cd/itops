# 后端环境变量示例，复制为 .env 后修改
NODE_ENV=development
PORT=3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itops
DB_USER=itops
DB_PASSWORD=itops_2026

# JWT 密钥（生产务必修改）
JWT_SECRET=change_this_secret_in_prod

# 首次启动创建的管理员初始口令（仅当用户表为空时生效），登录后请立即修改
DEFAULT_ADMIN_PASSWORD=admin123

# 文件上传目录（绝对或相对）
UPLOAD_DIR=./uploads

# 备份包存放目录
BACKUP_DIR=./backups

# 前端地址（用于 CORS）
FRONTEND_ORIGIN=http://localhost:5173

# 注意：AI 接口不再使用全局环境变量，改为「每用户独立配置」。
# 每个用户在系统「AI 助手」页面自行填写自己的供应商、API 地址与 Token，
# 互不影响，避免多人共用同一 Token。此处无需配置。
